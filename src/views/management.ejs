<%- include('partials/header') %>

<main class="container py-5">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-4 fw-bold">Volunteer Dashboard</h1>
            <p class="lead text-muted">Manage your service projects and volunteer commitments.</p>
        </div>
    </div>

    <!-- Flash Messages -->
    <% if (messages.success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= messages.success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    <% if (messages.error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= messages.error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <div class="row g-4">
        <!-- Organizations Management -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="display-4 text-primary mb-3"><i class="bi bi-building"></i></div>
                    <h3 class="h4 fw-bold">Organizations</h3>
                    <p class="text-muted">Add new organizations or edit existing ones.</p>
                    <div class="d-grid gap-2">
                        <a href="/organization/new" class="btn btn-primary rounded-pill">Add New</a>
                        <a href="/organization" class="btn btn-outline-secondary rounded-pill">View All</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Projects Management -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="display-4 text-success mb-3"><i class="bi bi-calendar-check"></i></div>
                    <h3 class="h4 fw-bold">Projects</h3>
                    <p class="text-muted">Launch new service projects or update details.</p>
                    <div class="d-grid gap-2">
                        <a href="/project/new" class="btn btn-success rounded-pill">Add New</a>
                        <a href="/project" class="btn btn-outline-secondary rounded-pill">View All</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Categories Management -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="display-4 text-info mb-3"><i class="bi bi-tags"></i></div>
                    <h3 class="h4 fw-bold">Categories</h3>
                    <p class="text-muted">Create focus areas or modify existing categories.</p>
                    <div class="d-grid gap-2">
                        <a href="/categories/new" class="btn btn-info text-white rounded-pill">Add New</a>
                        <a href="/categories" class="btn btn-outline-secondary rounded-pill">View All</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Users Management (Admin Only) -->
        <% if (user && user.role === 'admin') { %>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="display-4 text-warning mb-3"><i class="bi bi-people"></i></div>
                    <h3 class="h4 fw-bold">User Management</h3>
                    <p class="text-muted">View and manage all registered users.</p>
                    <div class="d-grid gap-2">
                        <a href="/users" class="btn btn-warning text-white rounded-pill">View All Users</a>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
    </div>

    <section class="mt-5" aria-labelledby="volunteer-projects-heading">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 id="volunteer-projects-heading" class="h3 fw-bold mb-1">My Volunteer Projects</h2>
                <p class="text-muted mb-0">Projects you have chosen to support.</p>
            </div>
            <a href="/project" class="btn btn-outline-primary rounded-pill">Browse Projects</a>
        </div>

        <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
            <div class="row g-3">
                <% volunteeredProjects.forEach(project => { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h3 class="h5 fw-bold"><a class="text-decoration-none" href="/project/<%= project.project_id %>"><%= project.project_name %></a></h3>
                                <p class="text-muted small mb-2"><i class="bi bi-calendar-event me-1"></i><%= new Date(project.date).toLocaleDateString() %></p>
                                <p class="text-muted small mb-3"><i class="bi bi-geo-alt me-1"></i><%= project.location %></p>
                                <p class="small flex-grow-1"><%= project.project_description %></p>
                                <a href="/project/<%= project.project_id %>/volunteer/remove" class="btn btn-outline-danger btn-sm rounded-pill w-100">Remove Volunteer Signup</a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-hand-thumbs-up display-5 text-primary"></i>
                    <h3 class="h5 fw-bold mt-3">No volunteer projects yet</h3>
                    <p class="text-muted">Browse the available projects and choose one that matches your interests.</p>
                    <a href="/project" class="btn btn-primary rounded-pill">Explore Service Projects</a>
                </div>
            </div>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>
